FROM hashicorp/terraform:1.16.1@sha256:f4d9594d2c8010c03f0149352682166410c58c21d46344cf256fd5a4b721a011 AS terraform

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY --from=terraform /bin/terraform /usr/local/bin/terraform

WORKDIR /app
COPY pyproject.toml README.md requirements-runtime.txt ./
COPY src ./src
COPY deploy/azure/review-inputs /review-inputs
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-runtime.txt \
    && python -m pip install --no-cache-dir --no-deps . \
    && useradd --system --uid 10001 --create-home elcapitan \
    && mkdir -p /data/review/artifacts \
    && chown -R elcapitan:elcapitan /data

USER 10001

ENTRYPOINT ["elcapitan", "prepare-review-worker"]
